{
  "name": "react-example",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "eval": "tsx eval/run.ts",
    "test:auth": "tsx eval/auth.test.ts && STORE=redis tsx eval/auth.test.ts && tsx eval/e2e.test.ts && tsx eval/gemini.test.ts && tsx eval/providers.test.ts",
    "test:vercel": "rm -rf .vercel-sim && tsc -p tsconfig.vercel-sim.json && REFRESH_REUSE_GRACE_MS=100 node eval/vercel-sim/sim.mjs",
    "test": "npm run eval && npm run test:auth && npm run test:vercel",
    "eval:llm": "tsx eval/run.ts --llm"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
